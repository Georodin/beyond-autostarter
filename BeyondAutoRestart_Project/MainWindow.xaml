<Window x:Class="BeyondAutoRestart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beyond Future Autostarter" Width="900" Height="500" MinWidth="715" MinHeight="290"
        Background="#1E1E2E" Foreground="White" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#4E4E6E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="PathText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Path}"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Label Content="Check _interval (s)" Target="{Binding ElementName=IntervalTextBox}"/>
            <TextBox x:Name="IntervalTextBox" Width="62" Margin="4,0,16,0" VerticalContentAlignment="Center"/>
            <Label Content="_Restart delay (s)" Target="{Binding ElementName=TimeoutTextBox}"/>
            <TextBox x:Name="TimeoutTextBox" Width="62" Margin="4,0,16,0" VerticalContentAlignment="Center"
                     ToolTip="Seconds an app must remain stopped before relaunching it."/>
            <CheckBox x:Name="BootCheckBox" Content="Start with Windows" Margin="0,0,16,0" Click="BootCheckBox_Click"/>
            <CheckBox x:Name="KillExplorerCheckBox" Content="Stop the Explorer shell"
                      ToolTip="For kiosk use. This can close the desktop and taskbar while a monitored app runs."/>
        </WrapPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="_Add EXE" DockPanel.Dock="Left" Click="AddRow_Click"/>
            <Button x:Name="SaveButton" Content="_Save" DockPanel.Dock="Right" Width="90" Click="SaveButton_Click"/>
            <TextBlock x:Name="FeedbackText" Margin="12,0" VerticalAlignment="Center"/>
        </DockPanel>

        <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#2D2D3E"
                  AlternationCount="2" RowBackground="#242438" AlternatingRowBackground="#2D2D3E"
                  Foreground="White" RowHeight="34">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Executable" Width="*" MinWidth="130" Binding="{Binding Path}"
                                    ElementStyle="{StaticResource PathText}"/>
                <DataGridTextColumn Header="First start after (s)" Width="124" Binding="{Binding FirstStartAfterSeconds}"/>
                <DataGridCheckBoxColumn Header="Start if stopped" Width="108" Binding="{Binding StartIfNotRunning}"/>
                <DataGridTextColumn Header="Status" Width="160" Binding="{Binding Status, Mode=OneWay}" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Actions" Width="154" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Browse" Margin="0,0,6,0" Click="BrowseRow_Click"/>
                                <Button Content="Remove" Click="RemoveRow_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
